    "web": "expo start --web",
    "lint": "expo lint",
    "test": "node scripts/run-unit-tests.js",
    "ios:build:dev": "eas build --profile development --platform ios",
    "ios:build:prev": "eas build --profile preview --platform ios",
    "ios:build:prod": "eas build --profile production --platform ios",
    "android:build:dev": "eas build --profile development --platform android",
    "android:build:prev": "eas build --profile preview --platform android",
    "android:build:prod": "eas build --profile production --platform android",
    "postinstall": "node ./scripts/patch-xcode-check.js"
  },
  "dependencies": {
